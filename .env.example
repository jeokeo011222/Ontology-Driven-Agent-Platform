# ODAP 本地开发环境变量样例（第十六篇 §8.3）。
# 复制为 .env 后按需修改：cp .env.example .env
# 本文件中的变量与 compose.yaml 中的 ${VAR} 一一对应；标记 :? 的变量缺失即启动失败。
# 注意：不要提交真实密码，.env 已在 .gitignore 中排除。

APP_ENV=development

ODAP_DB_PASSWORD=replace-with-local-secret
MOCKERP_DB_PASSWORD=replace-with-local-secret

# 应用运行时账号：odap_app（迁移 000011 创建，非超级用户、无 BYPASSRLS，RLS 生效）
# 说明：第十六篇 §8.3 样例以 owner 账号 odap 连接；此处改为 odap_app 是为让 RLS 真实
# 生效（第二篇 §9.2：应用角色不得是超级用户、不得有 BYPASSRLS；odap 是超级用户会绕过
# 全部策略）。迁移 000017 会依据**本行连接串的密码**自动设置 odap_app 角色密码，
# 因此改密码只需改这一行（单一真值来源）。
ODAP_DATABASE_URL=postgres://odap_app:apppw@postgres:5432/odap?sslmode=disable
# 迁移专用 owner 账号：仅 cmd/migrate 使用（DDL/GRANT 需要），与应用账号分离
ODAP_MIGRATE_URL=postgres://odap:replace-with-local-secret@postgres:5432/odap?sslmode=disable
# 注意：容器网络内 mockerp-db 监听 5432；5433 只是映射到宿主机的端口。
MOCKERP_DATABASE_URL=postgres://mockerp:replace-with-local-secret@mockerp-db:5432/mockerp?sslmode=disable
# 可选：覆盖 mockerp-db 的宿主映射端口（默认 5433，见 compose.yaml）。仅当本机 5433 被占用时设置。
# MOCKERP_DB_HOST_PORT=5443

ODAP_HTTP_ADDR=:8080
MOCKERP_HTTP_ADDR=:8081

OBJECT_STORE_MODE=local
OBJECT_STORE_LOCAL_DIR=.odap-objectstore
# 启动 objectstore profile 后改用 MinIO 端点（以下两项 compose 以 :? 断言，缺失即启动失败）
OBJECT_STORE_ACCESS_KEY=replace-with-local-secret
OBJECT_STORE_SECRET_KEY=replace-with-local-secret
# OBJECT_STORE_MODE=s3
# OBJECT_STORE_ENDPOINT=http://objectstore:9000

LOG_LEVEL=info
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=30

# ── 生成类端点的真实模型端点（AI 自动生成：本体/Agent/工具/工作流）───────────
# 留空 → 生成端点 fail-closed 返回 503 并在响应体说明原因，绝不产出假内容
# （第九篇 §4.4 凭据治理 / 第五篇 §6.2 语义资产治理）。要真正启用“AI 自动生成”，
# 需填一个 OpenAI 兼容的 HTTP 端点，例如本地 Ollama：
#   ODAP_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   （api 在容器内，访问宿主机服务用 host.docker.internal；Linux 下可改用宿主局域网 IP）
# 凭据可走两条路径（二选一）：
#   ① 环境变量注入：下方 ODAP_LLM_API_KEY / ODAP_LLM_API_KEY_REF，数据库只存变量名引用；
#   ② 界面录入：在「模型与推理」页直接填 api-key，服务端以 AES-256-GCM 信封加密后
#      存入 llm.endpoints.credential_ciphertext，界面只回显打码值（末 4 位）。
# 两条路径的明文都绝不进入 SQL 参数 / 审计事件 / 日志 / SSE payload。
ODAP_LLM_BASE_URL=
ODAP_LLM_API_KEY=
# 可选：显式指定承载密钥的 env 变量名（默认 ODAP_LLM_API_KEY）。
ODAP_LLM_API_KEY_REF=

# ── 凭据加密主密钥（模型端点密文凭据）──────────────────────────────────────
# 32 字节 AES-256-GCM 主密钥，base64 或 64 位 hex 编码。生成方式：
#   openssl rand -base64 32
# 留空 → 界面「填 api-key」路径 fail-closed 返回 503（绝不落明文）；
# 环境变量引用路径不受影响。更换主密钥会使既有密文凭据无法解密，须重新录入。
ODAP_SECRET_MASTER_KEY=
# 制度文档语料根目录（镜像内默认 /app/docs/资料，一般无需修改）。
ODAP_DOCS_ROOT=/app/docs/资料

# ── 图存储（RDF）──────────────────────────────────────────────────────────
# 选型依据：docs/图数据库的选型.md（Fuseki + TDB2）+ docs/adr/ADR-004。
#   postgres（默认）：三元组落在 PostgreSQL 的 graph schema，不需要额外服务。
#   fuseki：RDF 落在 Apache Jena Fuseki + TDB2，需先
#           `docker compose --profile graphstore up -d fuseki`。
# 取值非法（例如把 fuseki 拼错）会让 api 启动失败，而不会静默回退到 postgres。
GRAPHSTORE_MODE=postgres
# 数据集根地址；适配器在其后追加 /query 与 /update 两个 SPARQL 端点。
FUSEKI_ENDPOINT=http://fuseki:3030/odap
# 可选认证；两项必须成对配置（只配其一会被拒绝启动）。
# ⚠️ 生产必须配置，并只允许受信网络访问：未认证的 SPARQL 端点等于任意 RDF 读写。
# FUSEKI_USERNAME=
# FUSEKI_PASSWORD=
# 单次 SPARQL 请求超时（秒），默认 30。
FUSEKI_TIMEOUT_SECONDS=30
# 仅当宿主机 3030 被占用时覆盖（容器内仍为 3030）。
# FUSEKI_HOST_PORT=3031

# ── 开发演示身份（仅 APP_ENV=development 有效）────────────────────────────
# 后端在开发环境装配 DevResolver，从 X-Odap-Dev-* 头解析身份
# （internal/api/middleware/auth.go）。compose 的 web 服务会把下面两个变量
# 交给 nginx 注入到 /api 反代请求上（deployments/nginx/web.conf.template）。
#
# 留空 = 不注入任何身份头 → 浏览器打开工作台得到 401 UNAUTHENTICATED
# （这与生产环境一致：生产必须走真实会话 Cookie）。
# 要本地演示，填成种子租户与任意主体 UUID 即可（主体无需预先存在于 iam.users，
# 授权判定仍由服务端按 memberships/roles 实时执行）。
#
# 生产部署不要设置这三项：既然后端不会装配 DevResolver，nginx 也不应注入该头。
# ODAP_DEV_TENANT=11111111-1111-1111-1111-111111111111
# ODAP_DEV_SUBJECT=22222222-2222-2222-2222-222222222222
# ODAP_DEV_SCOPES=workspace.view,run.read,approval.read

# ── 演示账号预填（登录页）────────────────────────────────────────────────
# nginx 容器托管的是**生产构建产物**（import.meta.env.DEV 恒为 false），因此
# 预填由构建期开关控制，改动后必须 `docker compose up -d --build web` 才生效。
# 说明：直接用 Vite 开发服务器（web/ 目录下 npm run dev）时默认就会预填，
# 无需设置本组变量。
# ODAP_DEV_PREFILL=true    # 默认 false：镜像产物不预填任何账号（fail-closed）
# ODAP_DEV_LOGIN_NAME=demo.admin
# ODAP_DEV_LOGIN_PASSWORD=odap-demo-2026   # 须与后端种子写入的口令一致（后端可用 ODAP_DEV_LOGIN_PASSWORD 覆盖）
