  {
    "id": "99999999-9999-4999-8999-999999999999",
    "agent_key": "finance-expense-auditor",
    "domain": "FINANCE",
    "description": "费用报销审核助手：读取报销单、校验制度合规性、给出审批建议（不直接写 ERP）",
    "plugin": {
      "id": "77777777-7777-4777-8777-777777777777",
      "plugin_key": "agent:finance-expense-auditor",
      "plugin_kind": "AGENT",
      "name": "费用审核助手",
      "description": "演示 Agent 插件",
      "version_id": "88888888-8888-4888-8888-888888888888",
      "version": "0.1.0",
      "manifest": {
        "kind": "AGENT",
        "agent_key": "finance-expense-auditor"
      }
    },
    "version": {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "version": "0.1.0",
      "status": "PUBLISHED",
      "input_schema": {
        "type": "object",
        "properties": {
          "expense_id": { "type": "string" },
          "amount": { "type": "number" }
        },
        "required": ["expense_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "decision": { "type": "string", "enum": ["APPROVE", "REJECT", "NEED_INFO"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["decision"]
      },
      "prompt_template": {
        "system": "你是企业费用报销审核助手。只依据提供的报销单数据与制度条款判断，不得臆测缺失字段。",
        "user": "报销单：{{expense}}\n制度：{{policy}}\n请给出 decision 与 reasons。"
      },
      "config": {
        "temperature": 0.0,
        "max_output_tokens": 1024
      },
      "dependency_manifest": {
        "ontology": ["finance-core@0.1.0"],
        "tools": [
          "erp.expense.query",
          "erp.vendor.lookup",
          "kb.policy.search",
          "knowledge-retrieval",
          "erp.expense.decide",
          "audit.ledger.append"
        ],
        "skills": ["enterprise-knowledge-qa"],
        "models": [],
        "notes": "READ 类工具可直接调用；erp.expense.decide 为 EXTERNAL_WRITE，需经人工复核门禁后才可执行。技能 enterprise-knowledge-qa 在运行期经 dependency_manifest.skills 展开（CompileSkills 取 PUBLISHED 版本，fail-closed：技能缺失或未发布则计划编译失败）。本版本未声明任何模型（内置 mock 供应商已下线）：请先在「模型与推理」录入真实模型端点并登记模型版本档案，再在此声明 models，否则该 Agent 的推理调用会以 UNAVAILABLE 明确失败，不会回退到模拟端点。"
      }
    }
  },

