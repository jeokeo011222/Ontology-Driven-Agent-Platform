        "artifacts": [
          {
            "id": "f0000000-0000-4000-8000-000000000011",
            "artifact_type": "OWL",
            "logical_path": "ontology/finance-core.ttl",
            "media_type": "text/turtle",
            "storage_uri": "seed://finance-demo/ontology/finance-core.ttl",
            "content": "@prefix ex: <https://odap.example/finance#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\nex:ExpenseClaim a owl:Class ; rdfs:label \"报销单\" .\nex:Employee a owl:Class ; rdfs:label \"员工\" .\nex:Budget a owl:Class ; rdfs:label \"预算\" .\nex:Department a owl:Class ; rdfs:label \"部门\" .\n\nex:submittedBy a owl:ObjectProperty ; rdfs:domain ex:ExpenseClaim ; rdfs:range ex:Employee .\nex:chargedTo a owl:ObjectProperty ; rdfs:domain ex:ExpenseClaim ; rdfs:range ex:Budget .\nex:approvedBy a owl:ObjectProperty ; rdfs:domain ex:ExpenseClaim ; rdfs:range ex:Employee .\nex:belongsTo a owl:ObjectProperty ; rdfs:domain ex:Employee ; rdfs:range ex:Department .\n\nex:amount a owl:DatatypeProperty ; rdfs:domain ex:ExpenseClaim ; rdfs:range xsd:decimal .\nex:claimDate a owl:DatatypeProperty ; rdfs:domain ex:ExpenseClaim ; rdfs:range xsd:date .\n"
          },
          {
            "id": "f0000000-0000-4000-8000-000000000012",
            "artifact_type": "SHACL",
            "logical_path": "ontology/finance-core.shacl.ttl",
            "media_type": "text/turtle",
            "storage_uri": "seed://finance-demo/ontology/finance-core.shacl.ttl",
            "content": "@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix ex: <https://odap.example/finance#> .\n\nex:ExpenseClaimShape a sh:NodeShape ;\n  sh:targetClass ex:ExpenseClaim ;\n  sh:property [ sh:path ex:amount ; sh:minInclusive 0.01 ; sh:maxCount 1 ; sh:message \"报销金额必须大于 0\" ] ;\n  sh:property [ sh:path ex:submittedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:message \"报销单必须有唯一提交人\" ] ;\n  sh:property [ sh:path ex:chargedTo ; sh:minCount 1 ; sh:message \"报销单必须归属预算\" ] .\n"
          },
          {
            "id": "f0000000-0000-4000-8000-000000000013",
            "artifact_type": "DOCUMENT",
            "logical_path": "ontology/README.md",
            "media_type": "text/markdown",
            "storage_uri": "seed://finance-demo/ontology/README.md",
            "content": "# Finance Core Ontology 0.1.0\n\n报销垂直切片本体，含 4 个类、4 个对象属性、2 个数据属性与 1 个 SHACL 形状。\n\n用于演示：受控语义查询、SHACL 校验与制度合规判定。\n"
          }
